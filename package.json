{
  "name": "joy-deep-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "通用 Agent 运行时（Harness）：NestJS 服务化主循环 + 8 类鲁棒性治理",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx src/eval/run.ts",
    "eval:gate": "tsx src/eval/gate.ts",
    "verify": "pnpm test && pnpm eval:gate",
    "demo": "tsx src/cli.ts",
    "report": "tsx src/orchestrate.ts",
    "start": "tsx src/main.ts",
    "start:dev": "tsx watch src/main.ts"
  },
  "keywords": [
    "agent",
    "harness",
    "react",
    "nestjs",
    "mcp",
    "a2a",
    "llm"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "dotenv": "^16.4.7",
    "openai": "^6.34.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "vitest": "^4.1.2"
  }
}
