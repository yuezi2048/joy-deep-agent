# 复制为 .env 后填写真实值；.env 永不提交
# ── 模型供应商（至少配一个）──
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
QWEN_API_KEY=

# 默认使用哪个供应商：deepseek / openai / qwen / ollama
# 配了多个 Key 时，选中的排第一，其余按 priority 依次兜底（熔断后自动转移）
AGENT_PROVIDER=deepseek

# ── 可选覆盖 ──
OPENAI_BASE_URL=
DEEPSEEK_BASE_URL=
AGENT_MODEL=
AGENT_TEMPERATURE=0.3
AGENT_MAX_TOKENS=4096

# 上下文预算（token）：历史超限即截断/压缩/丢弃
AGENT_CONTEXT_TOKENS=32000
AGENT_TOOL_RESULT_TOKENS=2000

# ── Ollama（本地，无需 Key）──
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5

# ── 幻觉防护（默认关：开启后要求结论标注来源，并在交付前多跑一次核查）──
# 结论要用 [tool:工具名] 标注来源，编造来源 / 无来源支撑会被打回重写
AGENT_SOURCE_CONSTRAINT=false
# 交付前让核查模型挑出没有依据的断言，不通过就回灌给主模型修正（最多 2 轮）
AGENT_SELF_CHECK=false

# ── 协议接入（ADR-0005 / ADR-0006）──
# 都是 JSON，留空即不接；不配时行为与没接协议时完全一致。
#
# MCP 工具来源：name -> 启动参数。拉起的每个 tool 会以 mcp__<name>__<tool> 注册进同一个工具表，
# 与内置工具共用中间件 / HITL / 依赖序。远端工具默认需要人工确认，除非它声明了 readOnlyHint。
# MCP_SERVERS={"orders":{"command":"npx","args":["tsx","path/to/mcp-server.ts"]}}
MCP_SERVERS=

# A2A 子 agent：name -> 服务地址。会注册成一个 delegate 工具，
# 调用方先读 <url>/.well-known/agent-card.json 发现能力，再按名片声明的 url 发任务。
# A2A_AGENTS={"translator":{"url":"http://localhost:8888"}}
A2A_AGENTS=

# ── 本 Harness 作为 A2A 服务端对外时的名片信息 ──
# 任务端点固定挂在 POST /a2a，名片在 /.well-known/agent-card.json
A2A_PUBLIC_URL=
A2A_AGENT_NAME=
A2A_AGENT_DESCRIPTION=

# ── 服务端口 ──
PORT=3000

# ── 会话记忆（ADR-0004）──
# memory（缺省）：会话只活在进程内，重启即丢，行为与从前一致
# file：会话与长期记忆落到 AGENT_MEMORY_DIR，换进程也能用同一 sessionId 把上下文接回来
#   跑 `pnpm run report` 想跨次累积长期记忆，就把它改成 file（CLI 每次进程只跑一个任务）
AGENT_MEMORY=memory
AGENT_MEMORY_DIR=.joy-agent/memory
# 新会话最多接回多少条历史；0 或负数表示不限
AGENT_MEMORY_HISTORY=40

# ── 多智能体编排（ADR-0007，入口 pnpm run report）──
# 报告落盘目录，相对路径解析到工作区根目录下（PathGuard 拦住越界）
AGENT_REPORT_DIR=.joy-agent/reports
# 波内并发上限；依赖关系决定波间顺序
AGENT_MAX_PARALLEL=3
# 计划步骤上限：计划越长越容易失控，宁可拆两次
AGENT_PLAN_MAX_STEPS=6
# 长期记忆的 scope：换一个值就是另一本账
AGENT_MEMORY_SCOPE=default

# ── 工作区沙箱（ADR-0008）──
# 收窄写盘：填了就让整个工作区只读、只有这个子目录可写；留空 = 全工作区可写（与从前一致）
# 读不受影响：工作区内的材料始终读得到，受限的只是「往哪儿写」
AGENT_WRITE_ROOT=
# 写盘配额（字节 / 文件数）；超限在落盘之前拒绝，也可据此解释「模型为什么没写出文件」
AGENT_MAX_FILE_BYTES=1048576
AGENT_MAX_TOTAL_BYTES=8388608
AGENT_MAX_FILES=200

# ── Skill 按触发条件注入（ADR-0009）──
# 技能目录（相对工作区）：其下每个子目录一份 SKILL.md；目录不存在 = 没有技能，不是错误
# 加 / 改 / 删 SKILL.md 后下一轮就生效，不用重启
AGENT_SKILLS_DIR=.joy-agent/skills
# 本次注入的 token 总量上限（单条技能正文另有 400 token 上限）；超了会如实标注没注入谁
AGENT_SKILL_TOKENS=1200
