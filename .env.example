# 复制为 .env 后填写真实值；.env 永不提交
# ── 模型供应商（至少配一个）──
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
QWEN_API_KEY=

# 默认使用哪个供应商：deepseek / openai / qwen / ollama
# 配了多个 Key 时，选中的排第一，其余按 priority 依次兜底（熔断后自动转移）
AGENT_PROVIDER=deepseek

# ── 可选覆盖 ──
OPENAI_BASE_URL=
DEEPSEEK_BASE_URL=
AGENT_MODEL=
AGENT_TEMPERATURE=0.3
AGENT_MAX_TOKENS=4096

# 上下文预算（token）：历史超限即截断/压缩/丢弃
AGENT_CONTEXT_TOKENS=32000
AGENT_TOOL_RESULT_TOKENS=2000

# ── Ollama（本地，无需 Key）──
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5

# ── 幻觉防护（默认关：开启后要求结论标注来源，并在交付前多跑一次核查）──
# 结论要用 [tool:工具名] 标注来源，编造来源 / 无来源支撑会被打回重写
AGENT_SOURCE_CONSTRAINT=false
# 交付前让核查模型挑出没有依据的断言，不通过就回灌给主模型修正（最多 2 轮）
AGENT_SELF_CHECK=false

# ── 服务端口 ──
PORT=3000
